#!/bin/bash
set -euo pipefail

dnf update -y
dnf install -y docker jq
systemctl enable --now docker
usermod -aG docker ec2-user

mkdir -p /opt/gatemind/uploads
chown 999:999 /opt/gatemind/uploads
chmod 775 /opt/gatemind/uploads

cat >/usr/local/bin/deploy-gatemind <<'SCRIPT'
#!/bin/bash
set -euo pipefail

AWS_REGION="${aws_region}"
ECR_REPOSITORY_URL="${ecr_repository_url}"
SECRET_KEY_ARN="${secret_key_secret_arn}"
MONGO_URI_ARN="${mongo_uri_secret_arn}"

aws ecr get-login-password --region "$AWS_REGION" \
  | docker login --username AWS --password-stdin "$${ECR_REPOSITORY_URL%%/*}"

docker pull "$ECR_REPOSITORY_URL:latest"

SECRET_KEY=$(aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$SECRET_KEY_ARN" --query SecretString --output text)
MONGO_URI=$(aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$MONGO_URI_ARN" --query SecretString --output text)

cat >/opt/gatemind/backend.env <<ENV
APP_ENV=production
PORT=5000
SECRET_KEY=$SECRET_KEY
MONGO_URI=$MONGO_URI
MONGO_DB_NAME=${mongo_db_name}
MONGO_USE_MOCK=false
UPLOAD_FOLDER=/app/uploads
ENABLE_FILE_LOGGING=false
ALLOWED_ORIGINS=${allowed_origins}
ENV

ADDITIONAL_SECRETS='${additional_secret_arns}'
echo "$ADDITIONAL_SECRETS" | jq -r 'to_entries[] | [.key, .value] | @tsv' | while IFS=$'\t' read -r NAME ARN; do
  VALUE=$(aws secretsmanager get-secret-value --region "$AWS_REGION" --secret-id "$ARN" --query SecretString --output text)
  printf '%s=%s\n' "$NAME" "$VALUE" >>/opt/gatemind/backend.env
done

docker rm -f gatemind-backend 2>/dev/null || true
docker run -d \
  --name gatemind-backend \
  --restart unless-stopped \
  --env-file /opt/gatemind/backend.env \
  -p 80:5000 \
  -v /opt/gatemind/uploads:/app/uploads \
  "$ECR_REPOSITORY_URL:latest"

docker image prune -f
SCRIPT

chmod 750 /usr/local/bin/deploy-gatemind
